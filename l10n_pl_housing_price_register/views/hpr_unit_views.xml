<odoo>
    <record id="hpr_unit_view_list" model="ir.ui.view">
        <field name="model">l10n_pl.hpr.unit</field>
        <field name="arch" type="xml">
            <list
                decoration-success="in_register and state == 'approved'"
                decoration-warning="in_register and state != 'approved'"
                decoration-muted="not in_register"
            >
                <field name="project_id" />
                <field name="stage_id" />
                <field name="name" />
                <field name="offer_state" />
                <field name="in_register" />
                <field name="price" />
                <field name="price_m2" />
                <field name="date_from" />
                <field name="offer_price" />
                <field name="state" widget="badge" />
                <field name="issue" />
            </list>
        </field>
    </record>
    <record id="hpr_unit_view_form" model="ir.ui.view">
        <field name="model">l10n_pl.hpr.unit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_approve"
                        type="object"
                        string="Approve price"
                        class="btn-primary"
                        invisible="state == 'approved'"
                        groups="l10n_pl_housing_price_register.group_hpr_manager"
                    />
                    <button
                        name="action_price_from_offer"
                        type="object"
                        string="Take price from offer"
                        invisible="not product_id"
                        groups="l10n_pl_housing_price_register.group_hpr_manager"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" invisible="1" />
                            <field name="stage_id" />
                            <field name="product_id" />
                            <field name="offer_state" />
                            <field name="in_register" widget="boolean_toggle" />
                        </group>
                        <group>
                            <field name="area" />
                            <field name="price" />
                            <field name="price_m2" />
                            <field name="date_from" />
                            <field name="total_price" />
                            <field name="offer_price" />
                            <field name="approved_by_id" />
                            <field name="approved_on" />
                        </group>
                        <group string="G. Appurtenant rooms">
                            <field name="annex_type" />
                            <field name="annex_ref" />
                            <field name="annex_price" />
                            <field name="annex_date" />
                        </group>
                    </group>
                    <field name="issue" invisible="not issue" class="text-danger" />
                    <notebook>
                        <page string="Approved prices" name="prices">
                            <field name="price_ids" />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
    <record id="hpr_unit_action" model="ir.actions.act_window">
        <field name="name">Units and prices</field>
        <field name="res_model">l10n_pl.hpr.unit</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="hpr_price_view_list" model="ir.ui.view">
        <field name="model">l10n_pl.hpr.price</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="approved_on" />
                <field name="name" />
                <field name="price" />
                <field name="price_m2" />
                <field name="area" />
                <field name="date_from" />
                <field name="in_register" />
                <field name="approved_by_id" />
            </list>
        </field>
    </record>
    <record id="hpr_price_action" model="ir.actions.act_window">
        <field name="name">Approved prices</field>
        <field name="res_model">l10n_pl.hpr.price</field>
        <field name="view_mode">list</field>
    </record>

    <record id="hpr_file_view_list" model="ir.ui.view">
        <field name="model">l10n_pl.hpr.file</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="day" />
                <field name="project_id" />
                <field name="record_count" />
                <field name="units" />
                <field name="url" widget="url" />
                <field name="md5" optional="hide" />
                <field name="ext_ident" optional="hide" />
            </list>
        </field>
    </record>
    <record id="hpr_file_view_form" model="ir.ui.view">
        <field name="model">l10n_pl.hpr.file</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="day" />
                            <field name="project_id" />
                            <field name="developer_id" />
                            <field name="record_count" />
                            <field name="units" />
                        </group>
                        <group>
                            <field name="name" />
                            <field name="url" widget="url" />
                            <field name="md5" />
                            <field name="ext_ident" />
                            <field name="structure_version" />
                            <field name="attachment_id" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="hpr_file_action" model="ir.actions.act_window">
        <field name="name">Daily files</field>
        <field name="res_model">l10n_pl.hpr.file</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
