#. module: l10n_pl_housing_price_register
#. odoo-python
#: code:addons/l10n_pl_housing_price_register/models/hpr_approval_mixin.py:0
msgid ""
"%(field)s: the text cannot start with = + - or @ (spreadsheets would read it"
" as a formula)."
msgstr ""
"%(field)s: tekst nie może zaczynać się od znaku = + - ani @ (arkusz "
"kalkulacyjny odczytałby go jako formułę)."

#. module: l10n_pl_housing_price_register
#. odoo-python
#: code:addons/l10n_pl_housing_price_register/models/hpr_developer.py:0
msgid "%(field)s: wrong format (%(hint)s)."
msgstr "%(field)s: nieprawidłowy format (%(hint)s)."

#. module: l10n_pl_housing_price_register
#. odoo-python
#: code:addons/l10n_pl_housing_price_register/models/hpr_unit.py:0
msgid "%(unit)s: %(field)s cannot be negative."
msgstr "%(unit)s: wartość pola „%(field)s” nie może być ujemna."

#. module: l10n_pl_housing_price_register
#. odoo-python
#: code:addons/l10n_pl_housing_price_register/models/hpr_unit.py:0
msgid ""
"%(unit)s: floor area %(area)s m² ≠ approved %(approved)s m², approve the "
"price again."
msgstr ""
"%(unit)s: powierzchnia użytkowa %(area)s m² ≠ zatwierdzona %(approved)s m², "
"zatwierdź cenę ponownie."

#. module: l10n_pl_housing_price_register
#. odoo-python
#: code:addons/l10n_pl_housing_price_register/models/hpr_unit.py:0
msgid "%(unit)s: on offer (%(state)s) but not in the register."
msgstr "%(unit)s: jest w ofercie (%(state)s), a nie trafia do rejestru."

#. module: l10n_pl_housing_price_register
#. odoo-python
#: code:addons/l10n_pl_housing_price_register/models/hpr_unit.py:0
msgid ""
"%(unit)s: price in the offer %(offer)s PLN ≠ price in the register "
"%(register)s PLN."
msgstr ""
"%(unit)s: cena w ofercie %(offer)s zł ≠ cena w rejestrze %(register)s zł."

#. module: l10n_pl_housing_price_register
#. odoo-python
#: code:addons/l10n_pl_housing_price_register/models/hpr_unit.py:0
msgid ""
"%(unit)s: stage “%(stage)s” has no open escrow account, the unit cannot go "
"to the price register."
msgstr ""
"%(unit)s: etap „%(stage)s” nie ma otwartego rachunku powierniczego, lokal "
"nie może trafić do rejestru cen."

#. module: l10n_pl_housing_price_register
#. odoo-python
#: code:addons/l10n_pl_housing_price_register/models/hpr_unit.py:0
msgid "%s: approval needs a price, a “from” date and the floor area."
msgstr ""
"%s: do zatwierdzenia potrzebne są cena, data „od” i powierzchnia użytkowa."

#. module: l10n_pl_housing_price_register
#. odoo-python
#: code:addons/l10n_pl_housing_price_register/models/hpr_unit.py:0
msgid ""
"%s: change waiting for approval (the file uses the last approved price, if "
"any)."
msgstr ""
"%s: zmiana czeka na zatwierdzenie (do pliku trafia ostatnia zatwierdzona "
"cena, jeśli jest)."

#. module: l10n_pl_housing_price_register
#. odoo-python
#: code:addons/l10n_pl_housing_price_register/models/hpr_stage.py:0
msgid "%s: enter the description and the amount, or nothing"
msgstr "%s: podaj opis i kwotę albo zostaw oba pola puste"

#. module: l10n_pl_housing_price_register
#. odoo-python
#: code:addons/l10n_pl_housing_price_register/models/hpr_unit.py:0
msgid "%s: sold - it left the file; untick “in register”."
msgstr "%s: sprzedany, nie ma go już w pliku; odznacz „w rejestrze”."

#. module: l10n_pl_housing_price_register
#. odoo-python
#: code:addons/l10n_pl_housing_price_register/models/hpr_stage.py:0
msgid "%s: the “from” date is missing"
msgstr "%s: brak daty „od”"

#. module: l10n_pl_housing_price_register
#. odoo-python
#: code:addons/l10n_pl_housing_price_register/models/hpr_unit.py:0
msgid "%s: there is no price in the offer."
msgstr "%s: w ofercie nie ma ceny."

