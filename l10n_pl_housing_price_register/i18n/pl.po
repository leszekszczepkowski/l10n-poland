#: model:ir.model.fields,help:l10n_pl_housing_price_register.field_l10n_pl_hpr_developer__ext_ident
msgid "36 characters, set once. Never change it."
msgstr "36 znaków, nadawany raz. Nigdy go nie zmieniaj."

#. module: l10n_pl_housing_price_register
#. odoo-python
#: code:addons/l10n_pl_housing_price_register/models/hpr_developer.py:0
msgid "9 digits"
msgstr "9 cyfr"

#. module: l10n_pl_housing_price_register
#: model:ir.model.fields,help:l10n_pl_housing_price_register.field_l10n_pl_hpr_developer__phone
msgid "9 digits without spaces or dashes; a + sign and prefix are allowed."
msgstr ""
"9 cyfr bez spacji i łączników; można dodać znak + i numer kierunkowy kraju."

#. module: l10n_pl_housing_price_register
#. odoo-python
#: code:addons/l10n_pl_housing_price_register/models/hpr_developer.py:0
msgid "9 or 14 digits"
msgstr "9 albo 14 cyfr"

#. module: l10n_pl_housing_price_register
#. odoo-python
#: code:addons/l10n_pl_housing_price_register/models/hpr_file.py:0
msgid "A daily file cannot be changed: dane.gov.pl already has a copy."
msgstr "Pliku dziennego nie można zmienić: dane.gov.pl ma już jego kopię."

#. module: l10n_pl_housing_price_register
#. odoo-python
#: code:addons/l10n_pl_housing_price_register/models/hpr_file.py:0
